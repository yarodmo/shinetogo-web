# Build-time vars (frontend, Vite). NO secretos aquí — solo URLs públicas.
# El pipeline de GitHub Actions las inyecta como Repository Variables
# (Settings → Secrets and variables → Actions → Variables) antes de
# "npm run build". Para desarrollo local, copia este archivo a .env.

# URL canónica del sitio (usada en <link rel="canonical">, og:url, og:image, JSON-LD)
VITE_SITE_URL=https://shinetogomobiledetailing.com

# Endpoint de producción del microservicio de leads (api/)
VITE_API_URL=https://api.shinetogomobiledetailing.com/api/book

# Nombre comercial que se muestra en el sitio, el correo de leads y los datos estructurados.
# Cambiarlo aquí cambia todo el sitio. (Variable del repo: VITE_BRAND_NAME y BRAND_NAME para la API.)
VITE_BRAND_NAME=ShineToGo Mobile Detailing

# Analítica y publicidad. Vacíos = no se carga nada y no aparece el aviso de cookies.
# Con valores, los scripts solo se cargan DESPUÉS de que la persona presiona "Aceptar".
VITE_GTM_ID=
VITE_GA4_ID=
# Si el Pixel de Meta ya está dentro del contenedor de GTM, deja esto vacío para no contar cada evento dos veces.
VITE_META_PIXEL_ID=
